{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eq-network.org/lab/runs/bundle.schema.json",
  "title": "GD-suite sweep bundle (schema_version 1)",
  "description": "One dial-lattice bundle: manifest.json + scalars.json + runs/c-*.json. Validated twice from this single document: Python jsonschema on export (experiments/gd_bundles/export.py) and ajv in eq-network CI (apps/site/scripts/validate-bundles.mjs). Code-level checks BOTH validators must add (JSON Schema cannot express them): (1) scalars arrays have length prod(shape); (2) each run's node field arrays have length T*N and global fields length T; (3) checksums in manifest match sha256 of the sibling files; (4) size gates: 400 KB per runs/*.json, 12 MB per bundle; (5) playback cell indices lie within shape.",
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "numberArray": { "type": "array", "items": { "type": "number" } },
    "manifest": {
      "type": "object",
      "required": [
        "schema_version", "contract_version", "bundle_id", "env", "suite",
        "created", "engine", "config_hash", "base_config", "overrides",
        "T", "n_seeds", "seed0", "representative_seed_index",
        "axes", "metrics", "trace_fields", "playback", "checksums"
      ],
      "properties": {
        "schema_version": { "const": "1" },
        "contract_version": { "const": "1.1" },
        "bundle_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "env": { "type": "string" },
        "suite": { "const": "gradual_disempowerment" },
        "created": { "type": "string" },
        "notes": { "type": "string" },
        "engine": {
          "type": "object",
          "required": ["package", "version", "git_rev", "jax_version", "platform"],
          "properties": {
            "package": { "type": "string" },
            "version": { "type": "string" },
            "git_rev": { "type": "string" },
            "jax_version": { "type": "string" },
            "platform": { "type": "string" }
          }
        },
        "config_hash": { "$ref": "#/$defs/sha256" },
        "base_config": { "type": "object" },
        "overrides": { "type": "object" },
        "mechanisms": { "type": "array" },
        "T": { "type": "integer", "minimum": 1 },
        "n_seeds": { "type": "integer", "minimum": 1 },
        "seed0": { "type": "integer" },
        "representative_seed_index": { "type": "integer", "minimum": 0 },
        "axes": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["name", "label", "values", "param_type"],
            "properties": {
              "name": { "type": "string" },
              "label": { "type": "string" },
              "values": { "type": "array", "minItems": 2, "items": { "type": "number" } },
              "param_type": { "enum": ["anchored", "tuned-for-legibility", "arbitrary-but-swept"] },
              "unit": { "type": "string" }
            }
          }
        },
        "metrics": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "direction", "definition_hash"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "direction": { "enum": ["up_good", "down_good", "neutral"] },
              "late_window": { "type": "number" },
              "definition_hash": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "trace_fields": {
          "type": "object",
          "required": ["global", "node", "static", "derived"],
          "properties": {
            "global": { "type": "array", "items": { "type": "string" } },
            "node": { "type": "array", "items": { "type": "string" } },
            "static": { "type": "array", "items": { "type": "string" } },
            "derived": { "type": "array", "items": { "type": "string" } }
          }
        },
        "playback": {
          "type": "object",
          "required": ["cells", "tick_stride"],
          "properties": {
            "cells": {
              "oneOf": [
                { "const": "all" },
                { "type": "array", "items": { "type": "array", "items": { "type": "integer", "minimum": 0 } } }
              ]
            },
            "tick_stride": { "const": 1 }
          }
        },
        "checksums": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "scalars": {
      "type": "object",
      "required": ["shape", "order", "metrics", "has_run"],
      "properties": {
        "shape": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "integer", "minimum": 2 } },
        "order": { "const": "row-major" },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["point", "lo", "hi"],
            "properties": {
              "point": { "$ref": "#/$defs/numberArray" },
              "lo": { "$ref": "#/$defs/numberArray" },
              "hi": { "$ref": "#/$defs/numberArray" }
            }
          }
        },
        "has_run": { "type": "array", "items": { "type": "integer", "enum": [0, 1] } }
      }
    },
    "run": {
      "type": "object",
      "description": "docs/web-trajectory-contract.md v1.1 payload; adj deliberately absent in v1 bundles.",
      "required": ["global", "node", "static", "meta"],
      "properties": {
        "global": { "type": "object", "additionalProperties": { "$ref": "#/$defs/numberArray" } },
        "node": { "type": "object", "additionalProperties": { "$ref": "#/$defs/numberArray" } },
        "static": { "type": "object", "additionalProperties": { "$ref": "#/$defs/numberArray" } },
        "system": {
          "type": "object",
          "required": ["nodes", "edges"],
          "properties": {
            "nodes": { "type": "array", "items": { "type": "object" } },
            "edges": { "type": "array", "items": { "type": "object" } }
          }
        },
        "meta": {
          "type": "object",
          "required": ["gameId", "T", "N", "seed", "params", "scalars"],
          "properties": {
            "gameId": { "type": "string" },
            "T": { "type": "integer", "minimum": 1 },
            "N": { "type": "integer", "minimum": 1 },
            "seed": { "type": "integer" },
            "params": { "type": "object" },
            "scalars": { "type": "object", "additionalProperties": { "type": "number" } }
          }
        }
      }
    }
  }
}
